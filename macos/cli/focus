#!/bin/bash
#
# focus — línea de comandos de Enfócate pe causa (macOS).
#
# Bloquea sitios editando /etc/hosts, dentro de un bloque marcado, y cierra las
# apps de tu lista mientras haya un bloqueo activo.
#
# Uso:
#   focus block instagram.com [x.com ...]   agrega sitios a tu lista
#   focus blockapp WhatsApp                 agrega una app a tu lista
#   focus list                              muestra tu lista
#   focus sesion [duración]                 sesión de enfoque (por defecto 1h30m)
#   focus lock <duración> [--auto]          igual que sesion, o la extiende
#                                           --auto: no bloquea las apps de auto-skip
#   focus status                            muestra el bloqueo y el tiempo restante
#
# Duración: 90m, 2h, 1h30m o 45 (minutos).
#
# Un bloqueo con candado no se puede terminar antes de tiempo, solo extender.
# Un servicio de root lo vuelve a aplicar cada 2 segundos y sobrevive a un
# reinicio. Al terminar el tiempo, el servicio se elimina y libera todo.
#
# Tus listas están en una carpeta de root y se editan desde el widget, solo
# cuando no hay ninguna sesión activa. Una línea con # está desactivada.

set -euo pipefail

HOSTS="/etc/hosts"
MARK_START="# >>> focus block >>>"
MARK_END="# <<< focus block <<<"
REDIRECT="127.0.0.1"

# Lock / enforcement (root-owned so the tool can't casually clear it)
LABEL="com.focus.enforcer"
FOCUS_DIR="/Library/Application Support/focus"
LOCK_FILE="$FOCUS_DIR/lock"
SITES_FILE="$FOCUS_DIR/sites"
APPS_FILE="$FOCUS_DIR/apps"
AUTO_SKIP_FILE="$FOCUS_DIR/auto-skip"
AUTO_SESSION=0
ENFORCER="/usr/local/libexec/focus-enforcer"
PLIST="/Library/LaunchDaemons/$LABEL.plist"

# Print usage
usage() {
  sed -n '3,/^$/p' "$0" | sed 's/^# \{0,1\}//'
  exit 1
}

# Normalize a domain: strip protocol, path, www. -> base domain
normalize() {
  echo "$1" | sed -E 's#^https?://##; s#/.*$##; s/^www\.//' | tr '[:upper:]' '[:lower:]'
}

# Read current site list (one per line), ignoring blanks
read_sites() {
  grep -E '^[a-z0-9][a-z0-9.-]*$' "$SITES_FILE" 2>/dev/null || true
}

# Agrega un elemento activado a una lista (si estaba desactivado, lo activa).
add_item() { # archivo, valor
  local tmp
  tmp="$(mktemp)"
  { grep -vxF -e "$2" -e "#$2" "$1" 2>/dev/null || true; echo "$2"; } > "$tmp"
  sudo mkdir -p "$FOCUS_DIR"
  sudo cp "$tmp" "$1"
  sudo chmod 644 "$1"
  rm -f "$tmp"
}

# Apps (process names) que se cierran mientras haya un bloqueo activo
read_apps() {
  grep -E '^[A-Za-z0-9][A-Za-z0-9 ._-]*$' "$APPS_FILE" 2>/dev/null || true
}

# Apps que este bloqueo debe cerrar
lock_apps() {
  if [ "$AUTO_SESSION" = 1 ] && [ -s "$AUTO_SKIP_FILE" ]; then
    read_apps | grep -vxF -f "$AUTO_SKIP_FILE" || true
  else
    read_apps
  fi
}

# ---- lock state helpers ---------------------------------------------------

# 0 (true) if a lock is currently active
lock_active() {
  [ -f "$LOCK_FILE" ] || return 1
  local until now
  until="$(sed -n '1p' "$LOCK_FILE" 2>/dev/null || true)"
  now="$(date +%s)"
  case "$until" in ''|*[!0-9]*) return 1 ;; esac
  [ "$now" -lt "$until" ]
}

lock_remaining() {
  local until now
  until="$(sed -n '1p' "$LOCK_FILE")"
  now="$(date +%s)"
  echo $(( until - now ))
}

fmt_dur() { # seconds -> "1h 05m"
  local s=$1
  printf '%dh %02dm' $(( s / 3600 )) $(( (s % 3600) / 60 ))
}

# Parse a duration like 90m / 2h / 1h30m / 45 (=minutes) -> seconds on stdout
parse_duration() {
  local d="$1" total=0 rest="$1" num unit
  if [[ "$d" =~ ^[0-9]+$ ]]; then
    echo $(( d * 60 )); return 0
  fi
  while [ -n "$rest" ]; do
    if [[ "$rest" =~ ^([0-9]+)([smhd])(.*)$ ]]; then
      num="${BASH_REMATCH[1]}"; unit="${BASH_REMATCH[2]}"; rest="${BASH_REMATCH[3]}"
      case "$unit" in
        s) total=$(( total + num )) ;;
        m) total=$(( total + num * 60 )) ;;
        h) total=$(( total + num * 3600 )) ;;
        d) total=$(( total + num * 86400 )) ;;
      esac
    else
      return 1
    fi
  done
  [ "$total" -gt 0 ] || return 1
  echo "$total"
}

# ---- applying the block ---------------------------------------------------

# Rewrite the managed block in /etc/hosts to match the current list.
apply() {
  local tmp
  tmp="$(mktemp)"
  sed "/^${MARK_START}$/,/^${MARK_END}$/d; /^# >>> focus ipv6 >>>$/,/^# <<< focus ipv6 <<<$/d" "$HOSTS" > "$tmp"
  local sites
  sites="$(read_sites)"
  if [ -n "$sites" ]; then
    {
      echo "$MARK_START"
      while IFS= read -r site; do
        [ -z "$site" ] && continue
        echo "$REDIRECT $site"
        echo "$REDIRECT www.$site"
        echo "::1 $site"
        echo "::1 www.$site"
      done <<< "$sites"
      echo "$MARK_END"
    } >> "$tmp"
  fi
  echo "Actualizando $HOSTS (puede pedirte la contraseña)..."
  sudo cp "$tmp" "$HOSTS"
  rm -f "$tmp"
  sudo dscacheutil -flushcache 2>/dev/null || true
  sudo killall -HUP mDNSResponder 2>/dev/null || true
}

# ---- installing the enforcement daemon ------------------------------------

install_daemon() {
  local until="$1" sites="$2"
  local enf_tmp plist_tmp lock_tmp
  enf_tmp="$(mktemp)"; plist_tmp="$(mktemp)"; lock_tmp="$(mktemp)"

  # The enforcer: a self-contained root daemon. It re-applies the block
  # every 2s until the timer expires, then removes itself entirely.
  cat > "$enf_tmp" <<'ENFORCER'
#!/bin/bash
set -u
HOSTS="/etc/hosts"
MARK_START="# >>> focus block >>>"
MARK_END="# <<< focus block <<<"
REDIRECT="127.0.0.1"
LABEL="com.focus.enforcer"
FOCUS_DIR="/Library/Application Support/focus"
LOCK_FILE="$FOCUS_DIR/lock"
SITES_FILE="$FOCUS_DIR/sites"
APPS_FILE="$FOCUS_DIR/apps"
AUTO_SKIP_FILE="$FOCUS_DIR/auto-skip"
AUTO_SESSION=0
ENFORCER="/usr/local/libexec/focus-enforcer"
PLIST="/Library/LaunchDaemons/$LABEL.plist"

write_block() { # arg: newline-separated sites ("" clears the block)
  local sites="$1" tmp
  tmp="$(mktemp)"
  sed "/^${MARK_START}$/,/^${MARK_END}$/d" "$HOSTS" > "$tmp"
  if [ -n "$sites" ]; then
    {
      echo "$MARK_START"
      while IFS= read -r s; do
        [ -z "$s" ] && continue
        echo "$REDIRECT $s"
        echo "$REDIRECT www.$s"
        echo "::1 $s"
        echo "::1 www.$s"
      done <<< "$sites"
      echo "$MARK_END"
    } >> "$tmp"
  fi
  if ! cmp -s "$tmp" "$HOSTS"; then
    cp "$tmp" "$HOSTS"
    dscacheutil -flushcache 2>/dev/null || true
    killall -HUP mDNSResponder 2>/dev/null || true
  fi
  rm -f "$tmp"
}

cleanup_and_exit() {
  write_block ""                      # unblock everything
  rm -f "$LOCK_FILE"
  rm -f "$PLIST" "$ENFORCER"
  launchctl bootout "system/$LABEL" 2>/dev/null || true
  exit 0
}

while true; do
  [ -f "$LOCK_FILE" ] || cleanup_and_exit
  until_epoch="$(sed -n '1p' "$LOCK_FILE" 2>/dev/null || true)"
  case "$until_epoch" in ''|*[!0-9]*) cleanup_and_exit ;; esac
  now="$(date +%s)"
  [ "$now" -ge "$until_epoch" ] && cleanup_and_exit
  sites="$(sed -n '2,$p' "$LOCK_FILE" | grep -v '^app:' || true)"
  write_block "$sites"
  while IFS= read -r a; do
    [ -n "$a" ] && pkill -U "$(stat -f %u /dev/console)" -x "${a#app:}" 2>/dev/null
  done < <(grep '^app:' "$LOCK_FILE" || true)
  sleep 2
done
ENFORCER

  cat > "$plist_tmp" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key>
  <array><string>$ENFORCER</string></array>
  <key>KeepAlive</key><true/>
  <key>RunAtLoad</key><true/>
  <key>ProcessType</key><string>Background</string>
</dict>
</plist>
PLIST

  # lock file: line 1 = until-epoch, then one site per line
  { echo "$until"; printf '%s\n' "$sites"; lock_apps | sed 's/^/app:/'; } > "$lock_tmp"

  echo "Instalando el servicio de bloqueo (necesita tu contraseña)..."
  sudo mkdir -p "$FOCUS_DIR" /usr/local/libexec
  sudo cp "$lock_tmp"  "$LOCK_FILE"; sudo chmod 644 "$LOCK_FILE"
  sudo cp "$enf_tmp"   "$ENFORCER";  sudo chmod 755 "$ENFORCER"
  sudo cp "$plist_tmp" "$PLIST";     sudo chmod 644 "$PLIST"
  rm -f "$enf_tmp" "$plist_tmp" "$lock_tmp"

  # (re)load — bootout first so an extend re-reads cleanly
  sudo launchctl bootout "system/$LABEL" 2>/dev/null || true
  sudo launchctl bootstrap system "$PLIST"
}


# ---------------------------------------------------------------------------

cmd="${1:-}"; shift || true

case "$cmd" in
  block)
    [ $# -eq 0 ] && usage
    for raw in "$@"; do
      site="$(normalize "$raw")"
      if ! [[ "$site" =~ ^[a-z0-9][a-z0-9.-]*$ ]]; then
        echo "sitio inválido: $raw"
        exit 1
      fi
      if grep -qxF "$site" "$SITES_FILE" 2>/dev/null; then
        echo "ya está en tu lista: $site"
      else
        add_item "$SITES_FILE" "$site"
        echo "agregado: $site"
      fi
    done
    # If a lock is running, fold the new sites into the enforced set too.
    if lock_active; then
      until="$(sed -n '1p' "$LOCK_FILE")"
      install_daemon "$until" "$(read_sites)"
    fi
    ;;

  blockapp)
    [ $# -eq 0 ] && { echo "Uso: focus blockapp <NombreDeLaApp>   ej. WhatsApp"; exit 1; }
    for a in "$@"; do
      a="${a%.app}"
      if ! [[ "$a" =~ ^[A-Za-z0-9][A-Za-z0-9\ ._-]*$ ]]; then
        echo "nombre de app inválido: $a"
        exit 1
      fi
      if grep -qxF "$a" "$APPS_FILE" 2>/dev/null; then
        echo "ya está en tu lista: $a"
      else
        add_item "$APPS_FILE" "$a"
        echo "app agregada: $a (se cierra mientras haya un bloqueo activo)"
      fi
    done
    if lock_active; then
      until="$(sed -n '1p' "$LOCK_FILE")"
      install_daemon "$until" "$(read_sites)"
    fi
    ;;

  unblock)
    echo "No se puede desbloquear a mano. La sesión termina sola y, sin sesión activa, tu lista se edita desde el widget."
    exit 1
    ;;

  off)
    echo "No se puede desbloquear a mano. La sesión termina sola y, sin sesión activa, tu lista se edita desde el widget."
    exit 1
    ;;

  lock)
    [ $# -eq 0 ] && { echo "Uso: focus lock <duración>   ej. 90m, 2h, 1h30m, 45"; exit 1; }
    secs="$(parse_duration "$1")" || { echo "Duración inválida: $1 (prueba 90m, 2h, 1h30m, 45)"; exit 1; }
    if [ "${2:-}" = "--auto" ]; then AUTO_SESSION=1; fi
    now="$(date +%s)"
    new_until=$(( now + secs ))

    sites="$(read_sites)"
    if [ -z "$sites" ] && [ -z "$(lock_apps)" ]; then
      echo "Tu lista de bloqueo está vacía. Agrega sitios o apps primero (focus block instagram.com)."
      exit 1
    fi

    if lock_active; then
      cur_until="$(sed -n '1p' "$LOCK_FILE")"
      if [ "$new_until" -le "$cur_until" ]; then
        echo "Ya está bloqueado por $(fmt_dur "$(lock_remaining)") más."
        echo "Solo puedes extender un bloqueo, no acortarlo."
        exit 1
      fi
      echo "Extendiendo el bloqueo a $(fmt_dur "$secs") desde ahora."
    else
      echo "Bloqueando por $(fmt_dur "$secs"). No hay desbloqueo anticipado."
    fi

    apply
    install_daemon "$new_until" "$sites"
    echo "Bloqueado hasta $(date -r "$new_until" '+%a %H:%M'). Bloqueando:"
    echo "$sites" | sed 's/^/  • /'
    ;;

  status)
    if lock_active; then
      echo "BLOQUEADO: quedan $(fmt_dur "$(lock_remaining)") (hasta $(date -r "$(sed -n '1p' "$LOCK_FILE")" '+%a %H:%M'))."
      echo "Sitios bloqueados:"
      sed -n '2,$p' "$LOCK_FILE" | grep -v '^[[:space:]]*$' | sed -e 's/^app:/  • (app) /' -e '/^  • (app) /!s/^/  • /'
    else
      echo "Sin bloqueo. No hay sesión activa."
      sites="$(read_sites)"
      if [ -n "$sites" ]; then
        echo "Lista de bloqueo:"
        echo "$sites" | sed 's/^/  • /'
      fi
    fi
    ;;

  sesion|sesión)
    # Sesión de enfoque: bloqueo con candado (por defecto 1h30m).
    exec "$0" lock "${1:-1h30m}"
    ;;

  list|ls|"")
    sites="$(read_sites)"; apps="$(read_apps)"
    if [ -z "$sites" ] && [ -z "$apps" ]; then
      echo "Aún no hay nada activado en tu lista."
      echo "Prueba: focus block instagram.com"
    fi
    if [ -n "$sites" ]; then
      echo "Sitios:"
      echo "$sites" | sed 's/^/  • /'
    fi
    if [ -n "$apps" ]; then
      echo "Apps:"
      echo "$apps" | sed 's/^/  • /'
    fi
    if lock_active; then echo "Bloqueado por $(fmt_dur "$(lock_remaining)") más."; fi
    ;;

  *)
    usage
    ;;
esac
